{
  "name": "postgres-sink-add-source-field",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "connection.url": "jdbc:postgresql://postgres:5432/testdb",
    "connection.user": "kafka",
    "connection.password": "kafka",

    "topics": "pg-users",

    "auto.create": "true",
    "auto.evolve": "true",

    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "id",

    "table.name.format": "users_transformed",

    "transforms": "addSource",

    "transforms.addSource.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.addSource.static.field": "source",
    "transforms.addSource.static.value": "kafka-connect-demo"
  }
}